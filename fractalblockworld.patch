+fn spawn_entity(kind: i32, x: f64, y: f64, z: f64, hp: i32, target_biome: i32, target_blk: u8) -> i32 {
+    var i: i32 = 0;
+    while i < MAX_ENTITIES {
+        if st.entities[i].active == 0 {
+            st.entities[i].active = 1;
+            st.entities[i].kind = kind;
+            st.entities[i].x = x;
+            st.entities[i].y = y;
+            st.entities[i].z = z;
