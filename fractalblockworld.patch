+                while wd <= st.depth {
+                    let wf = get_frame(wd);
+                    let wbx = (wf.bx + sdx + CHUNK_DIM) & 15;
+                    let wby = (wf.by + sdy + CHUNK_DIM) & 15;
+                    let wbz = (wf.bz + sdz + CHUNK_DIM) & 15;
