+fn point_collides(x: f64, y: f64, z: f64) -> i32 {
+    let rad: f64 = 0.24;
+    var dz: i32 = -1;
+    while dz <= 1 {
+        var dy: i32 = -1;
+        while dy <= 1 {
+            var dx: i32 = -1;
+            while dx <= 1 {
+                let bx = ffloor(x + dx * rad);
+                let by = ffloor(y + dy * rad);
+                let bz = ffloor(z + dz * rad);
+                let blk = get_block(bx, by, bz);
+                if is_block_solid(blk) != 0 {
+                    return 1;
+                }
+                dx = dx + 1;
+            }
+            dy = dy + 1;
+        }
+        dz = dz + 1;
+    }
+    return 0;
+}
