+fn camera_forward(fx: f64&, fy: f64&, fz: f64&) {
+    let cp = fcos(st.pitch);
+    fx = cp * fcos(st.yaw);
+    fy = fsin(st.pitch);
+    fz = cp * fsin(st.yaw);
+}
