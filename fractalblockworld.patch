+static GLint g_u_sky_yaw = -1, g_u_sky_pitch = -1;
+static GLint g_u_mvp = -1, g_u_cam = -1, g_u_fog_col = -1, g_u_fog_params = -1;
+static GLint g_u_time = -1, g_u_flash = -1;
