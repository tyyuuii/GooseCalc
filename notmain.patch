+fn ctrl_center_from_layout(l: MobileLayout&, id: i32, cx_out: i32&, cy_out: i32&) {
+    if id == CTRL_STICK { cx_out = l.stick_cx; cy_out = l.stick_cy; }
+    else if id == CTRL_FIRE { cx_out = (l.fire_x1 + l.fire_x2) / 2; cy_out = (l.fire_y1 + l.fire_y2) / 2; }
+    else if id == CTRL_ALT  { cx_out = (l.alt_x1 + l.alt_x2) / 2;   cy_out = (l.alt_y1 + l.alt_y2) / 2; }
+    else if id == CTRL_USE  { cx_out = (l.use_x1 + l.use_x2) / 2;   cy_out = (l.use_y1 + l.use_y2) / 2; }
+    else if id == CTRL_SHRK { cx_out = (l.shk_x1 + l.shk_x2) / 2;   cy_out = (l.shk_y1 + l.shk_y2) / 2; }
+    else if id == CTRL_GROW { cx_out = (l.grw_x1 + l.grw_x2) / 2;   cy_out = (l.grw_y1 + l.grw_y2) / 2; }
+    else if id == CTRL_TK   { cx_out = (l.tk_x1 + l.tk_x2) / 2;     cy_out = (l.tk_y1 + l.tk_y2) / 2; }
+    else if id == CTRL_UP   { cx_out = (l.up_x1 + l.up_x2) / 2;     cy_out = (l.up_y1 + l.up_y2) / 2; }
+    else if id == CTRL_DN   { cx_out = (l.dn_x1 + l.dn_x2) / 2;     cy_out = (l.dn_y1 + l.dn_y2) / 2; }
+    else if id == CTRL_BRK  { cx_out = (l.brk_x1 + l.brk_x2) / 2;   cy_out = (l.brk_y1 + l.brk_y2) / 2; }
+    else if id == CTRL_RL   { cx_out = (l.rl_x1 + l.rl_x2) / 2;     cy_out = (l.rl_y1 + l.rl_y2) / 2; }
+    else if id == CTRL_RR   { cx_out = (l.rr_x1 + l.rr_x2) / 2;     cy_out = (l.rr_y1 + l.rr_y2) / 2; }
+}
