+fn save_push_u64(v: u64) {
+    fbw_save_push_i32((v & 0xFFFFFFFF) as! i32);
+    fbw_save_push_i32(((v >> 32) & 0xFFFFFFFF) as! i32);
+}
+
+fn load_pop_u64() -> u64 {
+    let lo = (fbw_load_pop_i32() as! u64) & 0xFFFFFFFF;
+    let hi = (fbw_load_pop_i32() as! u64) & 0xFFFFFFFF;
+    return lo | (hi << 32);
+}
+
+fn save_push_frame(f: ScaleFrame) {
+    fbw_save_push_i32(f.bx);
+    fbw_save_push_i32(f.by);
+    fbw_save_push_i32(f.bz);
+    fbw_save_push_i32(f.biome);
+    fbw_save_push_i32(f.parent_block as! i32);
+    save_push_u64(f.seed);
+}
+
+fn load_pop_frame() -> ScaleFrame {
+    let bx = clamp_i(fbw_load_pop_i32(), 0, 15);
+    let by = clamp_i(fbw_load_pop_i32(), 0, 15);
+    let bz = clamp_i(fbw_load_pop_i32(), 0, 15);
+    let bio = clamp_i(fbw_load_pop_i32(), 0, 9);
+    let pb = clamp_i(fbw_load_pop_i32(), 0, 63) as! u8;
+    let sd = load_pop_u64();
+    return ScaleFrame { bx: bx, by: by, bz: bz, biome: bio, parent_block: pb, seed: sd };
+}
