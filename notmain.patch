+fn hit_test_control(l: MobileLayout&, x: i32, y: i32) -> i32 {
+    if in_box(x, y, l.fire_x1, l.fire_y1, l.fire_x2, l.fire_y2) { return CTRL_FIRE; }
+    if in_box(x, y, l.alt_x1,  l.alt_y1,  l.alt_x2,  l.alt_y2)  { return CTRL_ALT; }
+    if in_box(x, y, l.use_x1,  l.use_y1,  l.use_x2,  l.use_y2)  { return CTRL_USE; }
+    if in_box(x, y, l.shk_x1,  l.shk_y1,  l.shk_x2,  l.shk_y2)  { return CTRL_SHRK; }
+    if in_box(x, y, l.grw_x1,  l.grw_y1,  l.grw_x2,  l.grw_y2)  { return CTRL_GROW; }
+    if in_box(x, y, l.tk_x1,   l.tk_y1,   l.tk_x2,   l.tk_y2)   { return CTRL_TK; }
+    if in_box(x, y, l.up_x1,   l.up_y1,   l.up_x2,   l.up_y2)   { return CTRL_UP; }
+    if in_box(x, y, l.dn_x1,   l.dn_y1,   l.dn_x2,   l.dn_y2)   { return CTRL_DN; }
+    if in_box(x, y, l.brk_x1,  l.brk_y1,  l.brk_x2,  l.brk_y2)  { return CTRL_BRK; }
+    if in_box(x, y, l.rl_x1,   l.rl_y1,   l.rl_x2,   l.rl_y2)   { return CTRL_RL; }
+    if in_box(x, y, l.rr_x1,   l.rr_y1,   l.rr_x2,   l.rr_y2)   { return CTRL_RR; }
+    if in_box(x, y, l.stick_cx - l.stick_r, l.stick_cy - l.stick_r,
+                    l.stick_cx + l.stick_r, l.stick_cy + l.stick_r) { return CTRL_STICK; }
+    return -1;
+}
