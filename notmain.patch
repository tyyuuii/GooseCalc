+    while ci < NUM_CTRLS {
+        fbw_save_push_i32(g_mob.ctrl_scale[ci]);
+        fbw_save_push_i32(g_mob.ctrl_ox[ci]);
+        fbw_save_push_i32(g_mob.ctrl_oy[ci]);
