+    fbw_save_push_i32((fclamp(st.vz, -500.0, 500.0) * 10000.0) as! i32);
+    fbw_save_push_i32((st.yaw * 100000.0) as! i32);
+    fbw_save_push_i32((st.pitch * 100000.0) as! i32);
