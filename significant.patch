+fn axis_step_at(d: i32, top_d: i32, delta: i32, axis: i32) -> i32 {
+    if delta == 0 { return 0; }
+    var k: i32 = d + 1;
+    while k <= top_d {
+        let f = get_frame(k);
+        let v = if axis == 0 { f.bx } else if axis == 1 { f.by } else { f.bz };
+        if (delta < 0 && v != 0) || (delta > 0 && v != 15) {
+            return 0;
+        }
+        k = k + 1;
+    }
+    return delta;
+}
